<td class="noPadding" i18n:domain="plone">
  <a tal:define="dummy view/saveHasActions;"
    tal:attributes="href string:${context/absolute_url}/@@collabora-edit;
                     class python: view.kwargs.get('ext_edit_action_class', '');
                     target string: '_blank');"
    target="_parent">
    <img src="edit.gif" tal:attributes="src string:${view/portal_url}/extedit_icon.png"
      title="External Edit" i18n:attributes="title" />
  </a>
</td>