<td class="noPadding" i18n:domain="imio.actionspanel">
  <a tal:define="dummy view/saveHasActions;
                 highlight python: view.showHistoryLastEventHasComments and view.historyLastEventHasComments();
                 iconName python: highlight and 'history_last_event_has_comment.gif' or 'history.gif'"
     tal:attributes="href string:${context/absolute_url}/@@contenthistorypopup;
                     class python: highlight and 'pat-plone-modal overlay-history highlight-history-link' or 'pat-plone-modal overlay-history';
                     data-pat-plone-modal view/HISTORY_MODAL_OPTIONS;">
    <tal:comment replace="nothing">iconName: Plone 4 icon file, the title msgid</tal:comment>
    <img src="history.svg"
         tal:attributes="src python: view.iconUrl('toolbar-action/history');
                         title string:${iconName}_icon_title;"
         title="History"
         i18n:attributes="title" />
  </a>
</td>
