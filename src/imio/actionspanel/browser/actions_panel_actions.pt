<td tal:repeat="action view/listObjectButtonsActions" class="noPadding" i18n:domain="plone">
  <tal:comment replace="nothing">An action with a 'modal' property (pat-plone-modal options) opens in a modal,
                                 as in Plone's Actions menu</tal:comment>
  <tal:defines define="dummy view/saveHasActions;
                       useOnClick python: action['url'].startswith('javascript');
                       modal python: not useOnClick and action.get('modal') or None;
                       modalClass python: modal and ' pat-plone-modal link-overlay-actionspanel' or '';">
    <a href="#"
       tal:attributes="class python: 'apButtonAction_form_%s%s' % (action['id'], modalClass);
                       onClick python: useOnClick and view.computeActionOnClick(action['url']) or '';
                       href python: not useOnClick and action['url'] or '';
                       target python: action['link_target'] or '_parent';
                       data-pat-plone-modal modal"
       tal:condition="python: view.useIcons and action['icon']">
      <img tal:attributes="src python: view.iconUrl(action['icon']);
                           title python: action['title'];" i18n:attributes="title" />
    </a>
  <tal:comment replace="nothing">Button, in a link when it opens a modal</tal:comment>
  <a tal:condition="python: not (view.useIcons and action['icon'])"
     tal:omit-tag="not: modal"
     tal:attributes="class python: modalClass.strip();
                     href action/url;
                     data-pat-plone-modal modal">
  <form tal:attributes="class python: 'apButtonAction_form_%s' % action['id'];
                        action action/url;">
    <input class="#"
           type="submit"
           i18n:attributes="value;title"
           tal:attributes="class python: 'apButton apButtonAction apButtonAction_%s' % action['id'];
                           title python: action['description'];
                           value python: action['title'];"/>
  </form>
  </a>
  </tal:defines>
</td>
