<div tal:condition="python: view.is_async and view.show()"
     id="async_actions_panel"
     data-use-icons="false"
     data-show-edit="false">
    <span class="spinner-border spinner-border-sm" role="status"></span>
</div>

<tal:renderViewlet condition="python: not view.is_async and view.show()"
                   replace="structure python: view.renderViewlet()" />
